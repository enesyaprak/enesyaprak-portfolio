---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getAllTags, getPosts, slugifyTag } from '../../../utils/posts';

export async function getStaticPaths() {
  const tags = await getAllTags();
  const posts = await getPosts();
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`“${tag}” etiketli yazılar.`}>
  <section class="page container">
    <header class="page__header">
      <p class="eyebrow"><a class="link" href="/blog/">Blog</a> / etiket</p>
      <h1>#{tag}</h1>
      <p class="lead">{posts.length} yazı</p>
    </header>
    <div class="grid grid--2" data-reveal-group>
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .page__header {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }
</style>
