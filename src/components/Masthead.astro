---
const now = new Date();
const monthFmt = new Intl.DateTimeFormat("tr-TR", { month: "long" }).format(now);
const dateStr = `${now.getDate()} ${monthFmt} ${now.getFullYear()}`;
const roman = (n: number) => {
  const v = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1];
  const s = ["M","CM","D","CD","C","XC","L","XL","X","IX","V","IV","I"];
  let r = ""; let i = 0;
  while (n > 0) { while (n >= v[i]) { r += s[i]; n -= v[i]; } i++; }
  return r;
};
const edition = roman(now.getFullYear());
---

<div class="relative z-30 px-6 md:px-10 pt-5 pb-3 border-b border-[var(--rule)] grid grid-cols-3 items-center mono text-[0.65rem] uppercase tracking-[0.22em] text-[var(--ink)]">
  <span class="justify-self-start flex items-center gap-2">
    <span class="inline-block w-1.5 h-1.5 bg-[var(--accent)] rounded-full"></span>
    <span>Field Notes</span>
    <span class="hidden sm:inline text-[var(--muted)]">/ no. {edition}</span>
  </span>

  <span class="justify-self-center text-[var(--muted)] hidden sm:block">
    İstanbul · 41.0082° N · 28.9784° E
  </span>

  <span class="justify-self-end text-[var(--muted)]">{dateStr}</span>
</div>
