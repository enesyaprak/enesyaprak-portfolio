---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section id="work" class="relative px-6 md:px-10 py-28 md:py-40">
  <!-- Section header -->
  <div class="grid grid-cols-12 gap-4 items-baseline border-b border-[var(--rule)] pb-4 mb-12">
    <span class="col-span-2 md:col-span-1 mono text-[0.62rem] uppercase tracking-[0.22em] text-[var(--accent)]">
      §01
    </span>
    <span class="col-span-10 md:col-span-7 mono text-[0.62rem] uppercase tracking-[0.22em]">
      Case Files — Selected works, chronological
    </span>
    <span class="hidden md:block md:col-span-4 text-right mono text-[0.62rem] uppercase tracking-[0.22em] text-[var(--muted)]">
      {projects.length} entries · ongoing
    </span>
  </div>

  <!-- Intro -->
  <div class="grid md:grid-cols-12 gap-4 mb-16">
    <div class="md:col-span-7">
      <h2
        class="display text-6xl md:text-8xl leading-[0.88] tracking-[-0.03em]"
        data-anim="split"
      >
        Yapıp <span class="italic text-[var(--accent)]">denediklerim.</span>
      </h2>
    </div>
    <div class="md:col-span-5 md:pt-6 self-end">
      <p class="text-base leading-[1.5] text-[var(--ink)]/80 max-w-md" data-anim="fade-up">
        Aşağıda hâlâ üzerinde çalıştığım, üzerinde çalıştığım ya da geçtiğim işlerden seçilmişler. Liste büyüyor.
      </p>
    </div>
  </div>

  <!-- Files -->
  <div>
    {projects.map((project, i) => (
      <ProjectCard project={project} index={i} total={projects.length} />
    ))}
    <div class="border-t border-[var(--rule)]"></div>
  </div>

  <!-- Footer -->
  <div class="mt-10 flex justify-between items-center mono text-[0.6rem] uppercase tracking-[0.22em] text-[var(--muted)]">
    <span>End of section</span>
    <span class="flex items-center gap-2">
      <span class="block w-4 h-px bg-[var(--muted)]"></span>
      Continued overleaf
    </span>
  </div>
</section>
