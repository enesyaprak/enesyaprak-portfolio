---
import type { Project } from '../utils/posts';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, stack, repo, url } = project.data;
---

<article class="project-card glass glass--hover">
  <div class="project-card__head">
    <h3>{title}</h3>
    <div class="project-card__links">
      {
        repo && (
          <a href={repo} target="_blank" rel="noopener" aria-label={`${title} — kaynak kod`} title="Kaynak kod">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5A12 12 0 0 0 8.2 23.9c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z" />
            </svg>
          </a>
        )
      }
      {
        url && (
          <a href={url} target="_blank" rel="noopener" aria-label={`${title} — canlı`} title="Canlı">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
  <p class="project-card__summary">{summary}</p>
  <ul class="project-card__stack" aria-label="Kullanılan teknolojiler">
    {stack.map((item) => <li class="pill">{item}</li>)}
  </ul>
</article>

<style>
  .project-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
  }
  .project-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .project-card__links {
    display: flex;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .project-card__links a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--text-2);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .project-card__links a:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
  .project-card__summary {
    color: var(--text-2);
    font-size: 0.97rem;
  }
  .project-card__stack {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
</style>
