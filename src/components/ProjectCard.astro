---
import type { Project } from "../data/projects";

export interface Props {
  project: Project;
  index: number;
  total: number;
}

const { project, index, total } = Astro.props;
const num = String(index + 1).padStart(2, "0");
const totalLabel = String(total).padStart(2, "0");
const isSoon = project.status === "soon";
const TagName = project.url && !isSoon ? "a" : "div";

const statusLabel =
  project.status === "live" ? "● Live" :
  project.status === "wip" ? "● In progress" :
  "○ Soon";

const statusColor =
  project.status === "live" ? "text-[var(--accent)]" :
  project.status === "wip" ? "text-[var(--navy)]" :
  "text-[var(--muted)]";
---

<TagName
  href={project.url}
  target={project.url ? "_blank" : undefined}
  rel={project.url ? "noopener noreferrer" : undefined}
  class:list={[
    "group relative block py-12 md:py-16 border-t border-[var(--rule)]",
    isSoon && "opacity-60",
  ]}
  data-cursor="grow"
  data-anim="fade-up"
>
  <!-- File header strip -->
  <div class="grid grid-cols-12 gap-4 items-center mb-6 mono text-[0.6rem] uppercase tracking-[0.22em]">
    <span class="col-span-2 md:col-span-1 text-[var(--accent)]">
      Case {num} / {totalLabel}
    </span>
    <span class={`col-span-5 md:col-span-2 ${statusColor}`}>{statusLabel}</span>
    <span class="hidden md:block md:col-span-6 text-[var(--muted)]">
      Filed — {project.year}{project.role ? ` · ${project.role}` : ""}
    </span>
    <span class="col-span-5 md:col-span-3 text-right text-[var(--muted)]">
      → {project.url ? new URL(project.url).hostname : "private"}
    </span>
  </div>

  <!-- Big title row -->
  <div class="grid grid-cols-12 gap-4 items-end">
    <h3 class="col-span-12 md:col-span-8 display text-6xl md:text-[8.5rem] leading-[0.85] tracking-[-0.03em] group-hover:text-[var(--accent)] transition-colors duration-500">
      {project.title}
    </h3>

    <div class="col-span-12 md:col-span-4 md:pb-4">
      <p class="text-base leading-[1.55] text-[var(--ink)]/85 max-w-sm">
        {project.description}
      </p>
    </div>
  </div>

  <!-- Tech tags + arrow -->
  <div class="mt-8 flex flex-wrap items-center gap-y-3 justify-between">
    <div class="flex flex-wrap gap-x-2 gap-y-1 mono text-[0.6rem] uppercase tracking-[0.22em] text-[var(--muted)]">
      {project.tech.length === 0 && <span>—</span>}
      {project.tech.map((t, i) => (
        <>
          {i > 0 && <span class="text-[var(--accent)]">/</span>}
          <span>{t}</span>
        </>
      ))}
    </div>

    {project.url && !isSoon && (
      <span class="mono text-[0.65rem] uppercase tracking-[0.22em] text-[var(--ink)] flex items-center gap-2 transition-transform duration-400 group-hover:translate-x-2">
        <span class="block w-10 h-px bg-[var(--ink)] group-hover:bg-[var(--accent)] transition-colors"></span>
        <span class="editorial-link">Open dossier</span>
        <span aria-hidden>↗</span>
      </span>
    )}
  </div>
</TagName>
