---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  lead?: string;
}
const { eyebrow, title, id, lead } = Astro.props;
---

<div class="section-heading" data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }
</style>
