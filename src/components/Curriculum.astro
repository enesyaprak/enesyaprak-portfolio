---
type Entry = { date: string; title: string; org?: string; note?: string };

const education: Entry[] = [
  {
    date: "2022 — 2026",
    title: "Bilgisayar Mühendisliği · B.Sc.",
    org: "Çanakkale Onsekiz Mart Üniversitesi",
    note: "4. sınıf · Mezuniyet tezi: MLOps × Cloud entegrasyonu",
  },
  {
    date: "2025",
    title: "Cloud & DevOps Specialization (AWS Cloud Foundations)",
    org: "EPAM Campus",
  },
  {
    date: "2025",
    title: "Cloud Technologies Bootcamp",
    org: "Ecodation Akademi",
  },
];

const hackathons: Entry[] = [
  {
    date: "Mart 2026",
    title: "İstanbul Toplu Taşıma için Analitik Çözümler",
    org: "Datathon",
  },
  {
    date: "Kasım 2025",
    title: "Bursa Akıllı Şehir Hackathonu",
    org: "Bursa Büyükşehir Belediyesi",
  },
];

const credentials: Entry[] = [
  {
    date: "2025",
    title: "Siber Güvenlik 101",
    org: "Akbank Gençlik Akademisi",
  },
  {
    date: "2025",
    title: "Girişimcilik Okulu",
    org: "Tech Istanbul",
  },
  {
    date: "ongoing",
    title: "Milli Teknoloji Hamlesi · Gönüllü",
    org: "T3 Vakfı",
  },
];

const sections: { n: string; title: string; entries: Entry[] }[] = [
  { n: "a.", title: "Eğitim", entries: education },
  { n: "b.", title: "Hackathon & Datathon", entries: hackathons },
  { n: "c.", title: "Sertifika & Gönüllülük", entries: credentials },
];
---

<section id="record" class="relative px-6 md:px-10 py-28 md:py-40">
  <!-- Section header -->
  <div class="grid grid-cols-12 gap-4 items-baseline border-b border-[var(--rule)] pb-4 mb-12">
    <span class="col-span-2 md:col-span-1 mono text-[0.62rem] uppercase tracking-[0.22em] text-[var(--accent)]">
      §04
    </span>
    <span class="col-span-10 md:col-span-7 mono text-[0.62rem] uppercase tracking-[0.22em]">
      On Record — Eğitim, hackathon, gönüllülük
    </span>
    <span class="hidden md:block md:col-span-4 text-right mono text-[0.62rem] uppercase tracking-[0.22em] text-[var(--muted)]">
      Doğrulanabilir kayıtlar
    </span>
  </div>

  <!-- Intro -->
  <div class="grid md:grid-cols-12 gap-4 mb-16">
    <div class="md:col-span-7">
      <h2
        class="display text-5xl md:text-7xl leading-[0.9] tracking-[-0.03em]"
        data-anim="split"
      >
        Sicil <span class="italic text-[var(--accent)]">kaydı.</span>
      </h2>
    </div>
    <div class="md:col-span-5 md:pt-6 self-end">
      <p class="text-base leading-[1.5] text-[var(--ink)]/80 max-w-md" data-anim="fade-up">
        Üniversite, bootcamp'ler, hackathonlar, sertifikalar ve gönüllülük — kâğıttaki kanıtlar.
      </p>
    </div>
  </div>

  <!-- Ledger -->
  <div class="grid md:grid-cols-3 gap-x-10 gap-y-14">
    {
      sections.map((section) => (
        <div data-anim="fade-up">
          <div class="flex items-baseline gap-2 mb-5 border-b border-[var(--ink)] pb-2">
            <span class="mono text-[0.6rem] uppercase tracking-[0.22em] text-[var(--accent)]">
              {section.n}
            </span>
            <h3 class="display text-2xl">{section.title}</h3>
          </div>
          <ul class="divide-y divide-[var(--rule)]">
            {section.entries.map((entry) => (
              <li class="py-4">
                <div class="mono text-[0.58rem] uppercase tracking-[0.22em] text-[var(--muted)] mb-1">
                  {entry.date}
                </div>
                <div class="display text-lg leading-[1.2] text-[var(--ink)]">
                  {entry.title}
                </div>
                {entry.org && (
                  <div class="text-sm text-[var(--ink)]/75 italic mt-1">
                    {entry.org}
                  </div>
                )}
                {entry.note && (
                  <div class="mono text-[0.58rem] uppercase tracking-[0.18em] text-[var(--muted)] mt-2">
                    {entry.note}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
