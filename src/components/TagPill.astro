---
import { slugifyTag } from '../utils/posts';
interface Props {
  tag: string;
  link?: boolean;
}
const { tag, link = true } = Astro.props;
---

{link ? <a class="pill pill--link" href={`/blog/etiket/${slugifyTag(tag)}/`}>#{tag}</a> : <span class="pill">#{tag}</span>}

<style>
  .pill--link:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
</style>
