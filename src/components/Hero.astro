---
const year = new Date().getFullYear();
---

<section
  id="top"
  class="relative px-6 md:px-10 pt-20 md:pt-24 pb-12 md:pb-16 min-h-[100svh] flex flex-col overflow-hidden"
>
  <!-- Dateline / opening info -->
  <div class="grid grid-cols-12 gap-4 items-end pt-6 md:pt-8 border-b border-[var(--rule)] pb-5">
    <div class="col-span-7 md:col-span-3 mono text-[0.6rem] md:text-[0.62rem] uppercase tracking-[0.22em] text-[var(--muted)] leading-relaxed">
      <div>Volume <span class="text-[var(--ink)]">VII</span></div>
      <div>Subject — Cloud · DevOps · MLOps · SaaS</div>
    </div>

    <div class="col-span-5 md:col-span-6 flex md:justify-center justify-end">
      <span class="stamp text-[0.55rem] md:text-[0.6rem]">Available · {year}</span>
    </div>

    <div class="hidden md:block md:col-span-3 mono text-[0.62rem] uppercase tracking-[0.22em] text-[var(--muted)] leading-relaxed text-right">
      <div>Filed under</div>
      <div class="text-[var(--ink)]">Student · Practitioner</div>
    </div>
  </div>

  <!-- Big name -->
  <div class="relative flex-1 flex items-center py-6 md:py-10">
    <h1 class="display w-full text-[15vw] md:text-[10.5vw] leading-[0.92] tracking-[-0.025em] pb-2">
      <span class="block" data-anim="split">Enes</span>
      <span class="block italic outline-text" data-anim="split">Yaprak</span>
    </h1>

    <!-- Foot annotation -->
    <div class="absolute right-0 top-2 md:top-4 hidden md:flex flex-col items-end gap-1 mono text-[0.6rem] uppercase tracking-[0.22em] text-[var(--muted)]">
      <span>Fig. 01</span>
      <span class="text-[var(--ink)]">— cloud, devops, mlops</span>
    </div>
  </div>

  <!-- Bottom row -->
  <div class="grid grid-cols-12 gap-4 items-end pt-5 md:pt-6 border-t border-[var(--rule)]">
    <div class="col-span-12 md:col-span-7" data-anim="fade-up">
      <p class="text-base md:text-xl leading-[1.4] max-w-2xl font-light">
        <span class="text-[var(--accent)]">§</span> Cloud, DevOps ve MLOps üzerinde çalışıyorum.
        <span class="italic">Terraform</span>, <span class="italic">Kubernetes</span>, <span class="italic">AWS SageMaker</span> ile altyapı;
        <span class="italic">LangGraph</span> ve <span class="italic">n8n</span> ile küçük ama gerçek SaaS'ler kuruyorum.
      </p>
    </div>

    <div class="col-span-12 md:col-span-5 flex md:justify-end items-end gap-6 mt-2 md:mt-0">
      <div class="mono text-[0.6rem] uppercase tracking-[0.22em] text-[var(--muted)] hidden md:block">
        <div class="flex items-center gap-2">
          <span class="block w-8 h-px bg-[var(--ink)]"></span>
          <span>Scroll for case files</span>
        </div>
      </div>
      <a
        href="#contact"
        class="mono text-[0.65rem] md:text-[0.7rem] uppercase tracking-[0.22em] text-[var(--ink)] flex items-center gap-2 group magnetic"
        data-cursor="grow"
        data-magnetic="0.3"
      >
        <span class="block w-2 h-2 rounded-full bg-[var(--accent)] group-hover:scale-150 transition-transform"></span>
        <span class="editorial-link">İletişime geç</span>
        <span aria-hidden>↗</span>
      </a>
    </div>
  </div>
</section>
