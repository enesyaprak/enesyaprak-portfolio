---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Ana sayfa: masaüstünde üst menü gizlenir, sol sütun menüsü kullanılır. */
  home?: boolean;
}
const { home = false, ...props } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body class:list={{ 'is-home': home }}>
    <a class="skip-link" href="#icerik">İçeriğe atla</a>
    <Nav />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 500;
  }
  .skip-link:focus {
    top: 0.75rem;
  }
  @media (min-width: 900px) {
    body.is-home .site-header {
      display: none;
    }
    body.is-home {
      scroll-padding-top: 1rem;
    }
  }
</style>
