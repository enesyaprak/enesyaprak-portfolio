---
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';
import TagPill from '../components/TagPill.astro';
import { site } from '../data/site';
import { profile } from '../data/profile';
import type { Post } from '../utils/posts';
import { formatDate, readingTime } from '../utils/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const minutes = readingTime(post.body);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'tr-TR',
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, site.url).toString(),
};
---

<BaseLayout title={title} description={description} type="article" publishedTime={pubDate} modifiedTime={updatedDate}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <article class="post container--narrow">
    <header class="post__header">
      <p class="post__meta muted">
        <a class="link" href="/blog/">Blog</a>
        <span aria-hidden="true">/</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} dk okuma</span>
      </p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      {
        tags.length > 0 && (
          <div class="post__tags">
            {tags.map((tag) => (
              <TagPill tag={tag} />
            ))}
          </div>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>
    {
      updatedDate && (
        <p class="post__updated muted">
          Son güncelleme: <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
        </p>
      )
    }
    <footer class="post__footer glass">
      <p>Yazı hakkında bir sorun ya da düzeltmen mi var?</p>
      <a class="btn" href={`mailto:${profile.emails[0]}?subject=${encodeURIComponent(`Yazı: ${title}`)}`}>E-posta gönder</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .post__header {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--border);
  }
  .post__header h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .post__updated {
    margin-top: var(--space-6);
    font-size: 0.85rem;
  }
  .post__footer {
    margin-top: var(--space-7);
    padding: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--text-2);
  }
</style>
